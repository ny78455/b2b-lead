# Database
DATABASE_URL=postgresql+asyncpg://b2b_user:b2b_pass@localhost:5432/b2b

# LLM (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-2-9b-it

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDER_EMAIL=outreach@yourcompany.com
SENDER_NAME="Your Name"
SENDER_COMPANY="Your Company"

# Unsubscribe
UNSUBSCRIBE_BASE_URL=http://localhost:8000

# IMAP
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_specific_password_here
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=300

# Google Sheets
GSPREAD_CREDENTIALS_FILE=credentials.json
SPREADSHEET_NAME="Google Maps Leads"

# Limits
DAILY_SEND_LIMIT=2000
HOURLY_SEND_LIMIT=1000
ENRICH_DELAY_SECONDS=1.0
