# Database
DATABASE_URL=postgresql+asyncpg://b2b_user:b2b_pass@localhost:5432/b2b

# LLM — Gemma 4 2B local (PRIMARY)
# HuggingFace model ID; the model is downloaded on first run (~5 GB).
GEMMA_LOCAL_MODEL_ID=google/gemma-4-2b-it

# LLM — Gemini API (FALLBACK, optional)
# Leave blank to disable the fallback entirely.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-2-9b-it

# Email (Gmail SMTP)
# 1. Enable 2-Step Verification on your Google account.
# 2. Go to Google Account → Security → 2-Step Verification → App passwords.
# 3. Create an App Password for "Mail" and paste it below (16 chars, no spaces).
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16char_app_password_here
SENDER_NAME="Your Name"
SENDER_COMPANY="Your Company"

# Unsubscribe
UNSUBSCRIBE_BASE_URL=http://localhost:8000

# IMAP (reply detection — reuse the same Gmail account)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16char_app_password_here
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=300

# Google Sheets
GSPREAD_CREDENTIALS_FILE=credentials.json
SPREADSHEET_NAME="Google Maps Leads"

# Limits
DAILY_SEND_LIMIT=2000
HOURLY_SEND_LIMIT=1000
ENRICH_DELAY_SECONDS=1.0
