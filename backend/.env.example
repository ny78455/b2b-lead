# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://b2b_user:b2b_pass@localhost:5432/b2b

# ── LLM — Gemini API (used for email draft generation) ───────────────────────
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Available models: gemini-2.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Email sending (Gmail SMTP) ─────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account.
# 2. Go to Google Account → Security → 2-Step Verification → App passwords.
# 3. Create an App Password for "Mail" and paste it below (16 chars, no spaces).
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16char_app_password_here
SENDER_NAME="Your Name"
SENDER_EMAIL=your_email@gmail.com
SENDER_COMPANY="Your Company"

# ── Calendar / scheduling link (embedded in outreach emails) ──────────────────
# Example: Calendly, Cal.com, Google Meet booking link, etc.
CALENDAR_LINK=https://calendly.com/your-link

# ── Unsubscribe ───────────────────────────────────────────────────────────────
UNSUBSCRIBE_BASE_URL=http://localhost:8000

# ── IMAP (reply detection — reuse the same Gmail account) ────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16char_app_password_here
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=300

# ── Google Sheets (Module 1 staging area) ────────────────────────────────────
GSPREAD_CREDENTIALS_FILE=credentials.json
SPREADSHEET_NAME="Google Maps Leads"

# ── Volume caps ───────────────────────────────────────────────────────────────
DAILY_SEND_LIMIT=2000
HOURLY_SEND_LIMIT=100
ENRICH_DELAY_SECONDS=1.0
